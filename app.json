{
  "expo": {
    "name": "Giroa",
    "slug": "giroa",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "giroa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mayc7n.giroa"
    },
    "android": {
      "package": "com.mayc7n.giroa",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
